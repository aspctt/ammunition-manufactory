<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- ================== Ammunition Manufactory ================== -->
	<ThingDef ParentName="BenchBase">
		<defName>AmmunitionManufactory</defName>
		<label>ammunition manufactory</label>
		<thingClass>Building_WorkTable</thingClass>
		<description>A workstation for automated ammunition production.</description>
		<graphicData>
			<texPath>Things/Building/AmmunitionManufactory/AmmunitionManufactory</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(7,4)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>200</costStuffCount>
		<costList>
			<Gold>50</Gold>
			<Steel>150</Steel>
			<ComponentSpacer>4</ComponentSpacer>
			<ComponentIndustrial>10</ComponentIndustrial>
		</costList>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>3000</WorkToBuild>
			<MaxHitPoints>200</MaxHitPoints>
			<Flammability>0.3</Flammability>
			<Cleanliness>-1</Cleanliness>
			<WorkTableWorkSpeedFactor>5</WorkTableWorkSpeedFactor>
		</statBases>
		<size>(5,2)</size>
		<designationCategory>Production</designationCategory>
		<!--uiOrder>2520</uiOrder-->
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>800</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Glower">
				<glowRadius>5</glowRadius>
				<glowColor>(73,123,138,0)</glowColor>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<building>
			<paintable>true</paintable>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<forceShowRoomStats>true</forceShowRoomStats>
		</building>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
		</researchPrerequisites>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
	</ThingDef>
</Defs>
