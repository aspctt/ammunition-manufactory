<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- CE only adds recipes for ammo used by at least one weapon to the benches listed per crafting tag -->
	<!-- CE overwrites same-tag entries across separate AmmoInjectorOptions defs, so extend its own def instead of adding a new one -->

	<!-- Ammo Bench -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/CombatExtended.AmmoInjectorOptions[defName="ammoInjectorOptions"]/benchesByTag/CE_AutoEnableCrafting</xpath>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/CombatExtended.AmmoInjectorOptions[defName="ammoInjectorOptions"]/benchesByTag/CE_AutoEnableCrafting</xpath>
			<value>
				<li>AmmunitionManufactory</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/CombatExtended.AmmoInjectorOptions[defName="ammoInjectorOptions"]/benchesByTag</xpath>
			<value>
				<CE_AutoEnableCrafting>
					<li>AmmunitionManufactory</li>
				</CE_AutoEnableCrafting>
			</value>
		</nomatch>
	</Operation>

	<!-- Machining Table -->
